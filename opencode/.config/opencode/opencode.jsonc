{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/opus-4-6",
  "permission": {
    "edit": "ask",                   // ask before editing files
    "bash": "allow"       
  },
  "autoupdate": true,
  "agent": {
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "anthropic/anthropic-opus-4-6",
      "prompt": "You are a code reviewer. Focus on security, readability, performance, and maintainability. Make sure we always use the latest APIs and good practices. Find ways to simplify things as much as possible and making recommendations on variable, file names and file structure.",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    }
  }
}

// list of models here: https://models.dev
